# Settings for docker compose: copy to .env (install.sh does) and edit.

# The PMC's IP address; empty: search the local network for it
PMC_IP=

# The OPC UA server: opc.tcp://<this machine>:<port>/
OPCUA_PORT=4840

# The xbot ids to offer as shuttles, e.g. 1,2,3; empty: the ones the PMC knows
SHUTTLES=

# 1: Reset and Start the table when the controller starts (else it starts Stopped, as the
# IEC 61499 modules do, and waits for Reset and Start over OPC UA)
AUTOSTART=0

# 1: the planner may push occupied shuttles that are not moving out of the way
DISPLACE_HELD=0

# Seconds a move may wait without getting closer before it fails with Blocked (20);
# 0: it waits until the way is free or it is stopped
BLOCKED_TIMEOUT_S=0

# The loading station, X,Y in mm (e.g. 60,180): the xbots nobody holds queue up on the slots
# nearest to it, the first one on it, and the table's Reset sends them there with the PMC's auto
# routing; empty: an xbot nobody holds stays where it was
LOADING_STATION=

# The idle orientation, degrees, a multiple of 90 (e.g. 0): the xbots nobody holds are turned to
# it (on a flyway centre), and the table's Reset turns every shuttle to it; empty: as they are.
# Also PlanarTable/Equipment/IdleRz over OPC UA (NaN: as they are).
IDLE_RZ=

# Linear motion of the xbots: m/s and m/s^2
XBOT_SPEED=0.5
XBOT_ACCEL=2.0

LOG_LEVEL=INFO
