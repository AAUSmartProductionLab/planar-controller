# Settings for docker compose: copy to .env (install.sh does) and edit.

# The PMC's IP address; empty: search the local network for it
PMC_IP=

# The OPC UA server: opc.tcp://<this machine>:<port>/
OPCUA_PORT=4840

# The xbot ids to offer as shuttles, e.g. 1,2,3; empty: the ones the PMC knows
SHUTTLES=

# 1: Reset and Start the table when the controller starts (else it starts Stopped, as the
# IEC 61499 modules do, and waits for Reset and Start over OPC UA)
AUTOSTART=0

# 1: the planner may push occupied shuttles that are not moving out of the way
DISPLACE_HELD=0

# Seconds a move may wait without getting closer before it fails with Blocked (20);
# 0: it waits until the way is free or it is stopped
BLOCKED_TIMEOUT_S=0

# The loading station, X,Y in mm (e.g. 60,180): the xbots nobody holds queue up on the slots
# nearest to it, the first one on it, and the table's Reset sends them there with the PMC's auto
# routing; empty: an xbot nobody holds stays where it was
LOADING_STATION=

# The idle orientation, degrees, a multiple of 90 (e.g. 0): the xbots nobody holds are turned to
# it (on a flyway centre), and the table's Reset turns every shuttle to it; empty: as they are.
# Also PlanarTable/Equipment/IdleRz over OPC UA (NaN: as they are).
IDLE_RZ=

# free: the xbots may travel anywhere on the table; line: only on the lanes of LINE_LAYOUT (the
# way between two places is always the same), turning only on its turn spots
MODE=free

# Line mode: the layout, a JSON file (in config/, which the container sees as config/, e.g.
# config/line-layout.json; see config/line-layout.example.json) or an http(s) URL to fetch it
# from at startup, e.g. the $value of the PlanarRouting collection in the line AAS's Parameters
# (the AAS Web UI's Configurator shows it). Its idleArea is the loading queue (LOADING_STATION
# is not used).
LINE_LAYOUT=

# Zones of the table, a JSON file (e.g. config/zones.json; see config/zones.example.json) or URL:
# switched off over OPC UA (PlanarTable/Equipment/Zones/<name>/Deactivate) to take xbots off the
# table or put new ones on while the rest goes on, or to slow the xbots down inside. Empty: none.
ZONES=

# How fast the xbots move, m/s and m/s^2 (PlanarTable/Equipment/SetSpeed changes it over OPC UA;
# a shuttle's own SetSpeed, or a payload the PMC allows less with, keeps one slower), and their
# jerk, m/s^3 (empty: the PMC's)
XBOT_SPEED=0.5
XBOT_ACCEL=2.0
XBOT_JERK=

LOG_LEVEL=INFO
